# Generated by `nic quickstart`.
#
# This is a regular NIC config. Edit it and run `nic deploy` to apply changes,
# or run `nic destroy` to delete the cluster.
project_name: {{ .ProjectName }}
domain: {{ .Domain }}

certificate:
  type: selfsigned

cluster:
{{- if or .HTTPPort .HTTPSPort }}
  local:
{{- if .HTTPPort }}
    http_port: {{ .HTTPPort }}
{{- end }}
{{- if .HTTPSPort }}
    https_port: {{ .HTTPSPort }}
{{- end }}
{{- else }}
  local: {}
{{- end }}

repository:
  local: {}
