# Installed by `nic quickstart`. This file is yours: edit it to change the
# Nebi configuration, or delete it to uninstall Nebi.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: nebi-pack
  namespace: argocd
  labels:
    app.kubernetes.io/part-of: nebari-software-packs
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: nebari-apps
  source:
    repoURL: https://github.com/nebari-dev/nebi-pack
    targetRevision: org-ca-bundle-key
    path: .
    helm:
      # data-science-pack derives Nebi's OIDC client ID from this release name.
      releaseName: nebi-pack
      valuesObject:
        nebariapp:
          hostname: nebi.{{ .Domain }}
        orgCABundle:
          configMapName: nebari-trust-bundle
          key: ca-certificates.crt
  destination:
    server: https://kubernetes.default.svc
    namespace: nebi
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    # The nebari-operator only manages namespaces carrying this label.
    managedNamespaceMetadata:
      labels:
        nebari.dev/managed: "true"
    syncOptions:
      - CreateNamespace=true
    # Retry indefinitely, on the latest revision so a fix from the next deploy
    # is picked up. See https://github.com/nebari-dev/nebari-infrastructure-core/issues/450
    retry:
      limit: -1
      refresh: true
      backoff:
        duration: 5s
        factor: 2
        maxDuration: 3m
