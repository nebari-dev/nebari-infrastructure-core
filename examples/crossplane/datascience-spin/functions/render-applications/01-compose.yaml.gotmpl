# code: language=yaml
# yaml-language-server: $schema=../../schemas/json/index.schema.json

{{- /* Fallbacks mirror the XRD schema defaults. The API server applies
     those on admission, but offline rendering has no API server, so the
     template repeats them to stay testable. */}}
{{- $nebi := default (dict) $xr.spec.nebi }}
{{- $nebiNS := dig "namespace" "nebi" $nebi }}
{{- $nebiRelease := dig "releaseName" "nebi-pack" $nebi }}
{{- $nebiVersion := dig "version" "0.1.3" $nebi }}
{{- $nebiExtra := dig "values" (dict) $nebi }}
{{- $ds := default (dict) $xr.spec.dataScience }}
{{- $dsNS := dig "namespace" "data-science" $ds }}
{{- $dsRelease := dig "releaseName" "data-science-pack" $ds }}
{{- $dsVersion := dig "version" "0.1.5" $ds }}
{{- $dsExtra := dig "values" (dict) $ds }}
{{- $dg := default (dict) $xr.spec.daskGateway }}
{{- $dgNS := dig "namespace" "dask-gateway" $dg }}
{{- $dgRelease := dig "releaseName" "dask-gateway-pack" $dg }}
{{- $dgVersion := dig "version" "3f35ed41115f25da8d029b2d9a55a66b4c7f2e12" $dg }}
{{- $dgExtra := dig "values" (dict) $dg }}
{{- $domain := $xr.spec.domain }}

{{- /* An Application is ready once ArgoCD reports it Healthy. */}}
{{- $nebiHealthy := false }}
{{- $dsHealthy := false }}
{{- $dgHealthy := false }}
{{- range $name, $r := .observed.resources }}
{{- $health := dig "status" "health" "status" "" $r.resource }}
{{- if and (eq $name "nebi-app") (eq $health "Healthy") }}{{ $nebiHealthy = true }}{{ end }}
{{- if and (eq $name "dsp-app") (eq $health "Healthy") }}{{ $dsHealthy = true }}{{ end }}
{{- if and (eq $name "dg-app") (eq $health "Healthy") }}{{ $dgHealthy = true }}{{ end }}
{{- end }}

{{- /* The api token z2jh generates for the dask-gateway hub
     service, exposed in the hub Secret for external consumers. */}}
{{- $dgToken := "" }}
{{- if .extraResources }}
{{- $found := index .extraResources "hub-secret" }}
{{- if and $found $found.items }}
{{- $raw := dig "data" "hub.services.dask-gateway.apiToken" "" (index $found.items 0).resource }}
{{- if $raw }}{{ $dgToken = b64dec $raw }}{{ end }}
{{- end }}
{{- end }}

{{- /* Wiring the composition owns. It wins over spec.*.values. */}}
{{- $nebiWiring := dict "nebariapp" (dict "hostname" (printf "nebi.%s" $domain)) }}
{{- $nebiValues := mergeOverwrite (deepCopy $nebiExtra) $nebiWiring }}
{{- $dsWiring := dict "keycloak" (dict "hostname" (printf "keycloak.%s" $domain)) }}
{{- $_ := set $dsWiring "nebi" (dict "namespace" $nebiNS "releaseName" $nebiRelease) }}
{{- /* Register the gateway as a hub service (z2jh then mints the token) and
     point notebooks at the gateway. */}}
{{- $dgRole := dict "services" (list "dask-gateway") "scopes" (list "read:users" "read:groups" "read:services") }}
{{- $dgHub := dict "services" (dict "dask-gateway" (dict)) "loadRoles" (dict "dask-gateway" $dgRole) }}
{{- $dgEnv := dict "DASK_GATEWAY__AUTH__TYPE" "jupyterhub" }}
{{- $_ := set $dgEnv "DASK_GATEWAY__ADDRESS" (printf "https://dask-gateway.%s" $domain) }}
{{- $_ := set $dgEnv "DASK_GATEWAY__PUBLIC_ADDRESS" (printf "https://dask-gateway.%s" $domain) }}
{{- $_ := set $dgEnv "DASK_GATEWAY__PROXY_ADDRESS" (printf "tls://traefik-%s.%s.svc.cluster.local:8786" $dgRelease $dgNS) }}
{{- $_ := set $dsWiring "jupyterhub" (dict "hub" $dgHub "singleuser" (dict "extraEnv" $dgEnv)) }}
{{- $dsValues := mergeOverwrite (deepCopy $dsExtra) $dsWiring }}
---
apiVersion: meta.gotemplating.fn.crossplane.io/v1alpha1
kind: ExtraResources
requirements:
  hub-secret:
    apiVersion: v1
    kind: Secret
    matchName: hub
    namespace: {{ $dsNS }}
---
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{ $xr.metadata.name }}-nebi
  namespace: argocd
  annotations:
    {{ setResourceNameAnnotation "nebi-app" }}
    {{- if $nebiHealthy }}
    gotemplating.fn.crossplane.io/ready: "True"
    {{- end }}
  labels:
    nebari.dev/spin: {{ $xr.metadata.name }}
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: nebari-apps
  source:
    repoURL: https://raw.githubusercontent.com/nebari-dev/helm-repository/gh-pages/
    chart: nebari-nebi-pack
    targetRevision: {{ $nebiVersion }}
    helm:
      releaseName: {{ $nebiRelease }}
      valuesObject:
        {{- toYaml $nebiValues | nindent 8 }}
  destination:
    server: https://kubernetes.default.svc
    namespace: {{ $nebiNS }}
  syncPolicy:
    managedNamespaceMetadata:
      labels:
        nebari.dev/managed: "true"
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
      - ServerSideApply=true
---
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{ $xr.metadata.name }}-data-science
  namespace: argocd
  annotations:
    {{ setResourceNameAnnotation "dsp-app" }}
    {{- if $dsHealthy }}
    gotemplating.fn.crossplane.io/ready: "True"
    {{- end }}
  labels:
    nebari.dev/spin: {{ $xr.metadata.name }}
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: nebari-apps
  source:
    repoURL: https://raw.githubusercontent.com/nebari-dev/helm-repository/gh-pages/
    chart: nebari-data-science-pack
    targetRevision: {{ $dsVersion }}
    helm:
      releaseName: {{ $dsRelease }}
      valuesObject:
        {{- toYaml $dsValues | nindent 8 }}
  destination:
    server: https://kubernetes.default.svc
    namespace: {{ $dsNS }}
  syncPolicy:
    managedNamespaceMetadata:
      labels:
        nebari.dev/managed: "true"
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
      - ServerSideApply=true
---
# Glue the packs' docs list as manual stopgaps: notebooks open TLS scheduler
# connections to the gateway's traefik.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: {{ $xr.metadata.name }}-singleuser-dask-scheduler-egress
  namespace: {{ $dsNS }}
  annotations:
    {{ setResourceNameAnnotation "np-dask-egress" }}
    gotemplating.fn.crossplane.io/ready: "True"
  labels:
    nebari.dev/spin: {{ $xr.metadata.name }}
spec:
  podSelector:
    matchLabels:
      app: jupyterhub
      component: singleuser-server
  policyTypes: ["Egress"]
  egress:
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ $dgNS }}
      ports:
        - protocol: TCP
          port: 8786
---
# The gateway's JupyterHub authenticator calls the hub api cross-namespace.
# The hub's default ingress policy only admits labeled same-namespace pods.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: {{ $xr.metadata.name }}-hub-ingress-from-dask
  namespace: {{ $dsNS }}
  annotations:
    {{ setResourceNameAnnotation "np-hub-ingress" }}
    gotemplating.fn.crossplane.io/ready: "True"
  labels:
    nebari.dev/spin: {{ $xr.metadata.name }}
spec:
  podSelector:
    matchLabels:
      app: jupyterhub
      component: hub
  policyTypes: ["Ingress"]
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: {{ $dgNS }}
      ports:
        - protocol: TCP
          port: 8081
{{- if $dgToken }}
---
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{ $xr.metadata.name }}-dask-gateway
  namespace: argocd
  annotations:
    {{ setResourceNameAnnotation "dg-app" }}
    {{- if $dgHealthy }}
    gotemplating.fn.crossplane.io/ready: "True"
    {{- end }}
  labels:
    nebari.dev/spin: {{ $xr.metadata.name }}
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: nebari-apps
  source:
    # Git-sourced at a pinned revision: the pack has no chart release yet.
    # ArgoCD's repo-server builds the (public) upstream subchart dependency.
    repoURL: https://github.com/nebari-dev/dask-gateway-pack
    path: chart
    targetRevision: {{ $dgVersion }}
    helm:
      releaseName: {{ $dgRelease }}
      valuesObject:
        {{- /* nebariapp backed by traefik so one hostname serves the REST
             api and the cluster dashboards (pack docs recommendation).
             apiTokenFromSecret* cleared: cross-namespace installs supply the
             token and hub url explicitly (pack values comment). */}}
        {{- $dgSvc := dict "name" (printf "traefik-%s" $dgRelease) "port" 80 }}
        {{- $dgApp := dict "enabled" true "hostname" (printf "dask-gateway.%s" $domain) "service" $dgSvc }}
        {{- $dgAuth := dict "apiToken" $dgToken "apiUrl" (printf "http://hub.%s.svc.cluster.local:8081/hub/api" $dsNS) "apiTokenFromSecretName" "" "apiTokenFromSecretKey" "" }}
        {{- $dgWiring := dict "nebariapp" $dgApp "dask-gateway" (dict "gateway" (dict "auth" (dict "jupyterhub" $dgAuth))) }}
        {{- toYaml (mergeOverwrite (deepCopy $dgExtra) $dgWiring) | nindent 8 }}
  destination:
    server: https://kubernetes.default.svc
    namespace: {{ $dgNS }}
  syncPolicy:
    managedNamespaceMetadata:
      labels:
        nebari.dev/managed: "true"
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
      - ServerSideApply=true
{{- end }}
