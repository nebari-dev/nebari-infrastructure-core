# code: language=yaml
# yaml-language-server: $schema=../../schemas/json/index.schema.json

# Two ArgoCD Applications (nebi-pack, then the data science pack) with the
# cross-pack wiring rendered here instead of hardcoded in either chart's
# values. All wiring is render-time derivation: this pair is
# convention-complete. Runtime consumption of pack-created resources
# (ExtraResources) is deferred to a pack with genuinely underivable outputs,
# e.g. dask-gateway's connection ConfigMap (issue #551).

{{- /* Fallbacks mirror the XRD schema defaults. The API server applies
     those on admission, but offline rendering has no API server, so the
     template repeats them to stay testable. */}}
{{- $nebi := default (dict) $xr.spec.nebi }}
{{- $nebiNS := dig "namespace" "nebi" $nebi }}
{{- $nebiRelease := dig "releaseName" "nebi-pack" $nebi }}
{{- $nebiVersion := dig "version" "0.1.3" $nebi }}
{{- $nebiExtra := dig "values" (dict) $nebi }}
{{- $ds := default (dict) $xr.spec.dataScience }}
{{- $dsNS := dig "namespace" "data-science" $ds }}
{{- $dsRelease := dig "releaseName" "data-science-pack" $ds }}
{{- $dsVersion := dig "version" "0.1.5" $ds }}
{{- $dsExtra := dig "values" (dict) $ds }}
{{- $domain := $xr.spec.domain }}

{{- /* An Application is ready once ArgoCD reports it Healthy. The ready
     annotation drives both XR readiness and the sequencer step. */}}
{{- $nebiHealthy := false }}
{{- $dsHealthy := false }}
{{- range $name, $r := .observed.resources }}
{{- $health := dig "status" "health" "status" "" $r.resource }}
{{- if and (eq $name "nebi-app") (eq $health "Healthy") }}{{ $nebiHealthy = true }}{{ end }}
{{- if and (eq $name "dsp-app") (eq $health "Healthy") }}{{ $dsHealthy = true }}{{ end }}
{{- end }}

{{- /* Wiring the composition owns. It wins over spec.*.values. */}}
{{- $nebiWiring := dict "nebariapp" (dict "hostname" (printf "nebi.%s" $domain)) }}
{{- $nebiValues := mergeOverwrite (deepCopy $nebiExtra) $nebiWiring }}
{{- $dsWiring := dict "keycloak" (dict "hostname" (printf "keycloak.%s" $domain)) }}
{{- $_ := set $dsWiring "nebi" (dict "namespace" $nebiNS "releaseName" $nebiRelease) }}
{{- $dsValues := mergeOverwrite (deepCopy $dsExtra) $dsWiring }}
---
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{ $xr.metadata.name }}-nebi
  namespace: argocd
  annotations:
    {{ setResourceNameAnnotation "nebi-app" }}
    {{- if $nebiHealthy }}
    gotemplating.fn.crossplane.io/ready: "True"
    {{- end }}
  labels:
    nebari.dev/spin: {{ $xr.metadata.name }}
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: nebari-apps
  source:
    repoURL: https://raw.githubusercontent.com/nebari-dev/helm-repository/gh-pages/
    chart: nebari-nebi-pack
    targetRevision: {{ $nebiVersion }}
    helm:
      releaseName: {{ $nebiRelease }}
      valuesObject:
        {{- toYaml $nebiValues | nindent 8 }}
  destination:
    server: https://kubernetes.default.svc
    namespace: {{ $nebiNS }}
  syncPolicy:
    managedNamespaceMetadata:
      labels:
        nebari.dev/managed: "true"
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
      - ServerSideApply=true
---
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{ $xr.metadata.name }}-data-science
  namespace: argocd
  annotations:
    {{ setResourceNameAnnotation "dsp-app" }}
    {{- if $dsHealthy }}
    gotemplating.fn.crossplane.io/ready: "True"
    {{- end }}
  labels:
    nebari.dev/spin: {{ $xr.metadata.name }}
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: nebari-apps
  source:
    repoURL: https://raw.githubusercontent.com/nebari-dev/helm-repository/gh-pages/
    chart: nebari-data-science-pack
    targetRevision: {{ $dsVersion }}
    helm:
      releaseName: {{ $dsRelease }}
      valuesObject:
        {{- toYaml $dsValues | nindent 8 }}
  destination:
    server: https://kubernetes.default.svc
    namespace: {{ $dsNS }}
  syncPolicy:
    managedNamespaceMetadata:
      labels:
        nebari.dev/managed: "true"
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
      - ServerSideApply=true
